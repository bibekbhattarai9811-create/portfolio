{
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/private/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ],
  "redirects": [
    { "source": "/Bibek-Bhattarai-CV.pdf", "destination": "/cv/", "permanent": false }
  ],
  "functions": {
    "api/cv-download.js": { "includeFiles": "private/**" }
  }
}
